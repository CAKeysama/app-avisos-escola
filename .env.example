# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - APP SALA DE AVISOS (FATEC / ESCOLA)
# Copie este arquivo para ".env" e preencha com suas credenciais oficiais.
# ==============================================================================

# Ambiente da Aplicação (development | staging | production)
APP_ENV=development
APP_NAME="Avisos Acadêmicos FATEC"
APP_VERSION=1.0.0

# Identidade Institucional
INSTITUTION_NAME="FATEC"
INSTITUTION_UNIT="Unidade Matão 297"
INSTITUTION_SUPPORT_EMAIL="gustavo.silva19@aluno.cps.sp.gov.br"

# Configurações do Firebase (Opcional se usar google-services.json / GoogleService-Info.plist)
FIREBASE_API_KEY=""
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_AUTH_DOMAIN=""

# Notificações Push (FCM)
FCM_SERVER_KEY=""
FCM_DEFAULT_TOPIC="school_all"

# Flags de Recursos
ENABLE_MOCK_DATA=true
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false

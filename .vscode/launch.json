{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app_sala_avisos (Celular / Rede Local - Porta 8080)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "web-server", "--web-hostname=0.0.0.0", "--web-port=8080"]
    },
    {
      "name": "app_sala_avisos (Chrome Web)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome"]
    },
    {
      "name": "app_sala_avisos (Windows Desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "windows"]
    }
  ]
}
